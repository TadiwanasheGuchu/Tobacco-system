# Copy to .env on the reception PC. Get STATION_CODE and STATION_SECRET from
# Admin > Scales in the floor web app ("Agent settings for this PC").
STATION_CODE=HAF-R1
STATION_SECRET=paste-the-secret-here
# The floor web app's address, exactly as staff open it in the browser.
ALLOWED_ORIGIN=https://floor.example.co.zw

# Scale: serial port of the indicator (Windows COM3, Linux /dev/ttyUSB0), or "sim".
SCALE_PORT=COM3
SCALE_BAUD=9600
# Regex for the weight in each line from the indicator, and (optional) its stable flag.
WEIGHT_PATTERN=([-+]?\s*\d+(?:\.\d+)?)\s*kg
STABLE_PATTERN=^ST
# Software stability check: weight must stay within the tolerance for this long.
STABLE_MS=1000
STABLE_TOLERANCE_KG=0.05
# Weights below this are not signed (empty scale).
MIN_SIGN_KG=5

# Label printer: tcp://IP:9100 for a network Zebra, file:./labels.zpl for testing, or none.
PRINTER=tcp://192.168.1.50:9100
