# Local time zone: "today" on the dashboard and report dates use it.
TZ=Africa/Harare

# PostgreSQL connection
DATABASE_URL="postgresql://tobacco:tobacco@localhost:5432/tobacco?schema=public"

# TIMB integration: "mock" until TIMB issues the integration spec and credentials.
TIMB_MODE=mock
# Mock only: fraction (0-1) of submissions that fail, to exercise retries.
TIMB_MOCK_FAIL_RATE=0
# How often the worker delivers TIMB records and text messages (ms).
WORKER_INTERVAL_MS=10000

# Grower text messages: SMS_ENABLED=false switches them off. "mock" logs instead
# of sending until an SMS gateway adapter is added (src/lib/sms/).
SMS_ENABLED=true
SMS_MODE=mock

# Bale mass limits accepted at reception (kg).
BALE_MIN_KG=20
BALE_MAX_KG=150

# Typed weights at reception. Set to false once every desk has a working scale;
# supervisors can still type a weight when a scale breaks (marked manual).
ALLOW_MANUAL_WEIGHTS=true

# Max share (%) of a settlement, after charges, that may go to input loan recovery.
LOAN_RECOVERY_MAX_PERCENT=100

# Set to "false" only if the floor server runs without HTTPS (not recommended).
COOKIE_SECURE=true

# Password for the demo accounts created by `npm run db:seed`.
SEED_PASSWORD=ChangeMe2026
